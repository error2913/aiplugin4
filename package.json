{
  "name": "aiplugin4",
  "version": "4.28.0",
  "description": "ai plugin for sealdice",
  "repository": "https://github.com/error2913/aiplugin4",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "cross-env NODE_ENV=production node tools/build.js",
    "build-dev": "cross-env NODE_ENV=dev node tools/build.js",
    "smoke": "node scripts/smoke.js",
    "test:ob11": "node scripts/test-ob11-runtime.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "package:check": "npm run build && node scripts/prepare-sealpack.js && sealpack validate sealpack && sealpack size sealpack",
    "pack:sealpack": "node scripts/prepare-sealpack.js && sealpack pack sealpack --out dist/aiplugin4.sealpack",
    "pack:release": "node scripts/build-release.js",
    "test:unit": "node scripts/test-unit.cjs",
    "sim": "node scripts/sim.cjs",
    "sim:matrix": "node scripts/sim-matrix.cjs",
    "fuzz": "node scripts/fuzz.cjs",
    "test:integration": "node scripts/integration-config-generator.mjs",
    "deps:graph": "node scripts/deps-graph.mjs",
    "deps:check": "node scripts/check-deps.mjs",
    "deps:update": "node scripts/check-deps.mjs --update",
    "version:check": "node scripts/sync-version.mjs",
    "changelog:check": "node scripts/gen-changelog.mjs",
    "changelog:gen": "node scripts/gen-changelog.mjs --write",
    "domain:check": "node scripts/gen-domain-default-data.mjs --check",
    "domain:gen": "node scripts/gen-domain-default-data.mjs",
    "version:sync": "node scripts/sync-version.mjs --write",
    "docs:build": "node docs-site/build.js",
    "docs:manifest": "node docs-site/check-manifest.js",
    "docs:serve": "node docs-site/build.js --serve"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "js-toml": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/handlebars": "^4.0.40",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "sealpack": "^0.1.2",
    "typescript": "^5.5.4"
  },
  "files": [
    "!**/*.spec.*",
    "!**/*.json",
    "LICENSE",
    "README.md"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true
  }
}
